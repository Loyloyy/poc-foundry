# poc-foundry environment — COPY to .env on the server and fill in. .env is gitignored (rule #1).
# NEVER commit real hosts, served-model ids, or keys. Placeholders below use the design's convention.

# ── Models: per-role triples (rule #4 — no model names in code; build_chat_model(role)) ──────────
# Roles: architect (strongest reasoner) · coder (make-or-break loop) · tester (may share coder
# endpoint) · critic (judge-family ≠ coder when possible) · scribe (cheapest capable).
# Set the served-model id EXACTLY as `GET <API_BASE>/v1/models` -> data[0].id (may have a leading /).
ARCHITECT_MODEL=<served-model-id>
ARCHITECT_API_BASE=http://<vllm-host:port>/v1
ARCHITECT_API_KEY=<any-non-empty-string>

CODER_MODEL=
CODER_API_BASE=
CODER_API_KEY=

TESTER_MODEL=
TESTER_API_BASE=
TESTER_API_KEY=

CRITIC_MODEL=
CRITIC_API_BASE=
CRITIC_API_KEY=

SCRIBE_MODEL=
SCRIBE_API_BASE=
SCRIBE_API_KEY=

# Blank role triples fall back to this role (single on-prem model runs everything). Default: architect.
PF_DEFAULT_ROLE=architect

# ── Sandbox / security ───────────────────────────────────────────────────────
PF_WORKSPACE_DIR=/path/to/local-disk/workspaces   # sandbox workspaces + uv cache on LOCAL disk
PF_VLLM_ALLOW_HOST=<vllm-host:port>               # single private-host egress exception (the proxy)
# The sacrificial in-VM inference key (low-value, rotatable) — buys inference only, nothing else.
PF_SANDBOX_VLLM_KEY=<any-non-empty-string>

# Reuse ONE uv-cache volume across builds so deps (e.g. gradio) download once — a TRUSTED-INPUT
# dev-loop SPEED-UP only. Default OFF = an isolated, torn-down-per-build cache. A shared cache is a
# cross-build channel; NEVER enable it when building untrusted artifacts.
PF_UV_CACHE_SHARED=0

# Out-of-process broker (M2a S4). Set to the Unix-socket path of the broker daemon → the orchestrator
# forwards all docker ops to the daemon (which alone holds docker.sock) instead of driving docker
# itself. Set by the compose override; UNSET → the in-process broker (default). See the override.
# PF_BROKER_SOCKET=/var/tmp/pf-broker/broker.sock

# ── Budgets / caps (override config/pipeline.yaml; see design §5.8) ───────────
# PF_MAX_FIX_ATTEMPTS= · PF_STUCK_RESEARCH_AFTER= · PF_MAX_ITERATIONS=
# PF_MAX_LLM_CALLS_ITER= · PF_MAX_LLM_CALLS_RUN= · PF_MAX_ITER_WALL_CLOCK_S= ·
# PF_MAX_RUN_WALL_CLOCK_S= · PF_TOOLCALLS_PER_ATTEMPT=

# ── Tests mode (design §5.5) ─────────────────────────────────────────────────
PF_TESTS_MODE=strict                              # strict | alongside (default strict; M0(b) A/Bs both)

# ── Observability (self-hosted Langfuse via ../service-depot; project stage-3-poc) ───────────────
PF_TRACING=0
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Search (SearXNG via ../service-depot, over depot-net) — research phase ────
SEARX_URL=http://searxng:8080

# ── Misc ──────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=                                     # optional, lifts GH API rate limit
PF_LLM_TIMEOUT_S=300
PF_LLM_MAX_RETRIES=3
