# Copy to docker-compose.override.yml (gitignored, rule #1) on the server for HOST-SPECIFIC bits that
# must never be tracked: local-disk paths, the docker socket (M1), GPU reservations, model paths.
# Compose auto-merges an override sitting next to the base file. Example only — adjust to the host.

services:
  app:
    volumes:
      # Sandbox workspaces + uv cache on LOCAL disk (design §2; never NFS). Mount PF_WORKSPACE_DIR at
      # the SAME path it has on the host — the M1 broker bind-mounts workspaces into Kata VMs by HOST
      # path (sibling-container semantics), so host-path must equal container-path. Pre-create +
      # chmod on the host first:  mkdir -p /var/tmp/pf-workspaces && chmod 777 /var/tmp/pf-workspaces
      - /var/tmp/pf-workspaces:/var/tmp/pf-workspaces
      # M1 ONLY — the in-process broker drives the host Docker (via the `docker` CLI baked into the
      # app image) to spin Kata VMs + the egress proxy. Mounting the socket is the risk-accepted M1
      # residual (DECISIONS; moves out-of-process at M2a). The orchestrator itself runs
      # egress-isolated; only the sacrificial vLLM key reaches the sandbox.
      - /var/run/docker.sock:/var/run/docker.sock
