# Copy to docker-compose.override.yml (gitignored, rule #1) on the server for HOST-SPECIFIC bits that
# must never be tracked: local-disk paths, the docker socket, GPU reservations, model paths.
# Compose auto-merges an override sitting next to the base file. Example only — adjust to the host.
#
# ── M2a S4: the broker runs OUT-OF-PROCESS ───────────────────────────────────────────────────────
# A `broker` daemon (reusing the app image) is the ONLY container that mounts /var/run/docker.sock.
# The orchestrator (`app`) mounts ONLY the broker RPC socket dir — never docker.sock — and reaches the
# daemon via PF_BROKER_SOCKET. This closes the M1 residual (the orchestrator held the socket).
# Bring the daemon up first (or rely on depends_on):  docker compose ... up -d broker
# Pre-create the shared dirs on the host:
#   mkdir -p /var/tmp/pf-workspaces /var/tmp/pf-broker && chmod 777 /var/tmp/pf-workspaces /var/tmp/pf-broker

services:
  app:
    depends_on:
      - broker
    environment:
      # Selects the out-of-process broker; UNSET → the in-process Broker (the default, M1 path).
      - PF_BROKER_SOCKET=/var/tmp/pf-broker/broker.sock
    volumes:
      # Sandbox workspaces + uv cache on LOCAL disk (design §2; never NFS). Mount PF_WORKSPACE_DIR at
      # the SAME path it has on the host — the broker bind-mounts workspaces into Kata VMs by HOST path
      # (sibling-container semantics), so host-path must equal container-path.
      - /var/tmp/pf-workspaces:/var/tmp/pf-workspaces
      # The broker RPC socket dir (NOT docker.sock). This is all the orchestrator gets.
      - /var/tmp/pf-broker:/var/tmp/pf-broker
      # NOTE: NO /var/run/docker.sock here anymore — the daemon below holds it (M2a S4).
      # M2c S3 experience loop: mount the curated playbooks so they inject into agent prompts AND so
      # Tier-1 auto-hints written at emit (playbooks/hints/<id>.md) PERSIST to the host across the
      # ephemeral `docker compose run --rm` (otherwise the loop never loops). hints/*.md are gitignored.
      # On NFS (root-squash maps the container's root → nobody), PRE-CREATE the hints dir writable so
      # the emit step can persist hints (same as builds/): `mkdir -p ../playbooks/hints && chmod 777
      # ../playbooks/hints`. Without it the build still succeeds — the hint is just skipped (tolerated-
      # absent) — but the loop won't persist. Curated playbooks still inject (read-only) regardless.
      - ../playbooks:/app/playbooks

  # ---- M3 web UI: it RUNS builds (single-slot RunManager) so it needs the SAME host-specific bits as
  #      `app` — the broker RPC socket + PF_WORKSPACE_DIR at the same path. Mirror them here. (The
  #      tracked compose.yaml already gives `web` the localhost port + the source/builds mounts.) ----
  web:
    depends_on:
      - broker
    environment:
      - PF_BROKER_SOCKET=/var/tmp/pf-broker/broker.sock
      # Browser-facing Langfuse URL for the UI "Traces" link (LANGFUSE_HOST is the in-network name a
      # laptop can't resolve). Optional — unset, the UI rewrites LANGFUSE_HOST's host to localhost.
      - PF_LANGFUSE_PUBLIC_URL=http://localhost:3000
      # Point the build-form source picker at the Stage-2 run folders (artifacts/<id>/vNN.json) so it
      # lists REAL research topics, not just the committed fixture. Must match the mount target below.
      - PF_ARTIFACTS_ROOT=/app/artifacts
    volumes:
      - /var/tmp/pf-workspaces:/var/tmp/pf-workspaces
      - /var/tmp/pf-broker:/var/tmp/pf-broker
      - ../playbooks:/app/playbooks
      # Stage-2 artifacts (READ-ONLY input, rule #6) — mount the ai-engineer-research artifacts dir so
      # the picker can read each run's topic. Adjust the host path to where Stage 2 writes them.
      - /path/to/ai-engineer-research/artifacts:/app/artifacts:ro

  # ---- Out-of-process broker daemon. The ONLY holder of the host docker socket; enforces the
  #      create-param invariant (rule #8) broker-side. Reuses the app image (has the docker CLI). ----
  broker:
    image: poc-foundry-app
    container_name: pf-broker
    command: python -m poc_foundry.sandbox.daemon
    env_file:
      - ../.env
    environment:
      - PF_BROKER_SOCKET=/var/tmp/pf-broker/broker.sock
      # M4 S2 (§5.2): the daemon durably records rejected create* (+ provision/destroy) APPEND-ONLY to
      # this file — readable independent of the orchestrator (it's on the shared pf-broker dir, written
      # only by the daemon). The orchestrator reads it at emit to feed security.incidents[]; the security
      # demo reads it directly as un-bypassable rule-#8 evidence.
      - PF_BROKER_AUDIT_LOG=/var/tmp/pf-broker/audit.log
      # M4 S2b key-proxy (OPT-IN; design §5.2 / DECISIONS #31). UNSET → normal builds are byte-for-byte
      # unchanged. When PF_KEYPROXY_UPSTREAM is set the broker provisions a per-build key-proxy: the REAL
      # key goes ONLY to the proxy container (here), the VM gets a per-build SACRIFICIAL token + the
      # proxy's base_url (PF_SANDBOX_MODEL_BASE_URL). Keeps a key-requiring provider's key out of the VM.
      #   PF_KEYPROXY_UPSTREAM = the real model server ROOT, no /v1 (e.g. http://<vllm-host:port>)
      #   PF_KEYPROXY_REAL_KEY = the real provider key — or, on the keyless vLLM, a CANARY to prove the
      #                          mechanism (the demo shows it never reaches the VM, yet inference works).
      # Put both in the gitignored ../.env (loaded by app + broker). The key-proxy runs the app image, so
      # it must contain keyproxy.py → `docker compose ... build app` once. Demo: cli demo-security shows a
      # 4th beat (right token → 200, wrong token → 401, real key absent).
      # - PF_KEYPROXY_UPSTREAM=http://<vllm-host:port>
      # - PF_KEYPROXY_REAL_KEY=<real-key-or-canary>
    volumes:
      - ../src:/app/src
      - ../config:/app/config
      # The daemon ALONE mounts the docker socket (it spins Kata VMs + the egress proxy on the host).
      - /var/run/docker.sock:/var/run/docker.sock
      # The shared RPC socket dir (the orchestrator connects here).
      - /var/tmp/pf-broker:/var/tmp/pf-broker
      # The daemon does NOT need the workspace mounted — it passes HOST paths to `docker run`, which the
      # host daemon resolves; only the app writes workspace files.
    networks:
      - depot-net
