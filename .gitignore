# ── Secrets & host-specific config (data-hygiene rule #1) ────────────────────
.env
.env.*
!.env.example
docker-compose.override.yml
# gitignored sidecar: the real role→model-id map. NOTE: .gitignore has NO inline comments — a `#`
# after a pattern on the SAME line becomes part of the pattern, so comments MUST be on their own line.
build_env.json

# ── Build outputs (server-local, gitignored — publishing a PoC is a human call)
builds/
# local-disk sandbox workspaces + uv cache
workspaces/
# checkpoint / state DBs
*.sqlite

# ── Diagnostic run artifacts. Bake-off traces can capture the model endpoint in an error message
#    (HTTPError repr includes the URL) — NEVER commit them. Also just run noise.
**/traces/
scripts/m0b_bakeoff/traces/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ── M3 web UI (React) ────────────────────────────────────────────────────────
# Frontend source lives in frontend/ and is built OFF-server (npm on the dev box, like Stage 2);
# node_modules is gitignored (frontend/.gitignore). The ONE exception to the blanket `dist/` above:
# the prebuilt React bundle IS committed (the server has no npm/registry, rule #3 — it serves the
# committed bundle straight). Re-include it. Rebuild + recommit after frontend changes:
#   cd frontend && npm install && npm run build
!src/poc_foundry/web/dist/
!src/poc_foundry/web/dist/**

# ── Experience loop (M2c S3) ─────────────────────────────────────────────────
# Tier-1 auto-hints are low-authority, EXPIRING, machine-local + LLM-generated (could echo an
# incident traceback) → never committed. Tier-2 promotion is a human merge INTO a curated playbook
# (scrubbed + reviewed). The curated playbooks + the hints/ README stay tracked.
playbooks/hints/*.md
!playbooks/hints/README.md

# ── Misc ──────────────────────────────────────────────────────────────────────
.DS_Store
*.log
logs/
.pytest_cache/
.ruff_cache/
